NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_. Needed for creating/assigning.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string. Vercel Cron sends it so only Vercel can run /api/cron/open-dues.
CRON_SECRET=generate-a-long-random-string

# ---- Login (one-time code by email) ----
# A long random string that signs the login cookie. Make one with:  openssl rand -hex 32
# Use a different value on your computer and on Vercel.
AUTH_SECRET=generate-with-openssl-rand-hex-32
# Resend (https://resend.com) sends the login code. The sending domain must be verified in Resend.
RESEND_API_KEY=re_bmmmmmmmmmm
RESEND_FROM="PMO <login@your-verified-domain.com>"
# On your own computer, if RESEND_API_KEY is left out, the code is printed in the terminal instead.

# ---- Microsoft Teams notifications (all optional; configure in Settings after deploying) ----
# Public address of this app, no trailing slash. Used for links in messages and the Microsoft sign-in return address.
APP_URL=https://your-app.vercel.app
# Who can open Settings (comma separated emails).
ADMIN_EMAILS=you@yourcompany.com
# "Send as my account": an Entra app registration (Web redirect: APP_URL/api/ms/callback)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "Teams bot": the bot's app (client) id + secret, and your tenant id
TEAMS_BOT_ID=
TEAMS_BOT_SECRET=
TEAMS_BOT_TENANT_ID=
